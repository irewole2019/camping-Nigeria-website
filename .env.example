# Copy to .env.local and fill in. Never commit real values.

# Resend — transactional email.
# If missing, forms fall back to opening a mailto: draft in the user's mail
# client (no server send).
RESEND_API_KEY=

# Upstash Redis — per-IP rate limiting on form submission routes.
# Both must be set in production. If either is missing, the rate limiter
# fails open (no throttle) so local dev works without an Upstash account.
# Get both from https://console.upstash.com/ → create a Redis database →
# "REST API" tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Padi Check also keeps its fast copy of the guest list here. A free Upstash
# database is archived after 30 days unused, and a dead one fails quietly, so
# a daily Vercel Cron (vercel.json -> /api/cron/upstash-heartbeat) writes to it
# and emails hello@ if it does not answer. Vercel sends this secret with each
# cron call; set it in Vercel (Production) to any long random string. Without
# it the heartbeat refuses every call.
CRON_SECRET=

# SEO / search console
# Optional: verification token from Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional: ISO date used for sitemap <lastmod> timestamps.
NEXT_PUBLIC_SEO_LAST_MODIFIED=2026-04-23T00:00:00.000Z

# Gear rental quote tool
# Published Google Sheets CSV for the rentable items list (items tab, gid=0).
# The /gear-rental form fetches this on mount to render the equipment selector.
# If missing or unreachable, the form falls back to a free-text message field.
NEXT_PUBLIC_SHEETS_ITEMS_URL=

# Base Camp Kids registration recording
# Google Apps Script Web App URL that appends a row to a registrations sheet.
# When unset, registrations still send emails — the Sheet step is skipped and
# logged. See lib/event-records.ts for the row schema.
GOOGLE_SHEETS_REGISTRATION_WEBHOOK_URL=

# Camp Night sign-ups
# Apps Script Web App URL for the Camp Night sheet — a SEPARATE deployment
# and a separate sheet from the Base Camp Kids one above. Step-by-step setup:
# docs/camp-night/SETUP.md (the script itself is docs/camp-night/apps-script.gs)
# When unset, sign-ups still send both emails; the Sheet append is skipped and
# logged, and the internal email carries every field so the row can be added
# by hand. The script also rejects a duplicate code, which is what makes the
# randomly generated SCN codes safe.
GOOGLE_SHEETS_CAMP_NIGHT_WEBHOOK_URL=

# MAD Settings sign-ups (31 October 2026)
# Apps Script Web App URL for the MAD Settings sheet — again a SEPARATE sheet
# and deployment. Setup: docs/mad-settings/SETUP.md (script:
# docs/mad-settings/apps-script.gs). Same fail-soft behaviour as Camp Night,
# and the same catch: the 80-tent cap is counted in the sheet, so while this
# is unset there is no cap. Attendance-only tickets are never capped.
GOOGLE_SHEETS_MAD_SETTINGS_WEBHOOK_URL=

# Padi Check — event QR check-in (usl-build/7-prd.md). Set in .env.local and
# Vercel only; the three secrets are 32 random bytes each, base64url.
# Shared secret for the Apps Script check-in actions; must equal the script's
# PADI_CHECK_SECRET Script Property.
PADI_CHECK_SCRIPT_SECRET=
# Password the door volunteer types to sign in (role: volunteer).
PADI_CHECK_PASSWORD=
# Password for the admin pages, card and printed list (role: admin).
PADI_CHECK_ADMIN_PASSWORD=
# HMAC key that signs the padi_session cookie.
PADI_CHECK_SESSION_SECRET=
# HMAC key that signs gate-pass QR image URLs.
GATE_PASS_SECRET=
# Number behind the "Call" button and on the printed card, international form
# (+234...). Never commit it.
PADI_CHECK_CALL_PHONE=

# inference.sh — image generation (GPT Image 2 etc.) for marketing assets.
# Used by local scripts under tools/ to generate Base Camp Kids hero, banner,
# and souvenir images. Get from https://app.inference.sh → Settings → API Keys.
INFERENCE_SH_API_KEY=
